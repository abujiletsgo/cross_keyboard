#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &five_column_transform;
    };
};

/ {
    //  Add tri-layer behavior here

    behaviors {
        tri_layer: sl_layer {
            compatible = "urob,zmk-behavior-simple-layer";
            label = "TRI_LAYER";
            layers = <1 2>;        // These are LWR and RSE layers
            target-layer = <3>;    // Layer 3 will activate when both are held
        };
    };

    combos {
        compatible = "zmk,combos";

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <21 20>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <2 3>;
        };

        gesture {
            bindings = <&mo 3>;
            key-positions = <36 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Primary {
            display-name = "QWERTY";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E        &kp R         &kp T                       &kp Y     &kp U   &kp I        &kp O    &kp P     &kp BSPC
&kp CAPSLOCK    &kp A  &kp S  &kp D        &kp F         &kp G                       &kp H     &kp J   &kp K        &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C        &kp V         &kp B                       &kp N     &kp M   &kp COMMA    &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                              &lt 2 SPACE  &kp LEFT_ALT  &mt LEFT_GUI C_AC_SEARCH    &kp RGUI  &tog 0  &lt 2 SPACE
            >;
        };

        Secondary {
            display-name = "NUMBER";
            bindings = <
&mt F1 TAB  &mt F2 NUMBER_1  &mt F3 NUMBER_2  &mt F4 NUMBER_3  &mt F5 NUMBER_4  &mt F6 N5    &mt F7 NUMBER_6  &mt F8 N7  &mt F9 N8     &mt F10 N9        &mt F11 N0         &mt F12 BACKSPACE
&trans      &none            &mkp MCLK        &mkp RCLK        &mkp LCLK        &mo 2        &mkp MB4         &none      &kp UP_ARROW  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
&trans      &kp SLASH        &kp ASTERISK     &kp MINUS        &kp PLUS         &none        &mkp MB5         &kp LEFT   &kp DOWN      &kp RIGHT         &kp EQUAL          &trans
                                              &trans           &trans           &trans       &trans           &trans     &trans
            >;
        };

        num_pad+media {
            bindings = <
&kp K_COFFEE  &kp LG(LS(NUMBER_4))      &mt C_RW C_PREV       &mt C_PP C_PP         &mt C_FAST_FORWARD C_NEXT  &bt BT_SEL 0    &kp ASTERISK  &kp N7        &kp N8        &kp N9        &kp PLUS    &bt BT_CLR
&trans        &kp LS(LC(LG(NUMBER_4)))  &kp K_MUTE            &kp C_VOL_DN          &kp C_VOLUME_UP            &bt BT_SEL 1    &kp SLASH     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS   &kp DOLLAR
&trans        &kp LS(LG(N5))            &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_AL_CONTROL_PANEL     &bt BT_SEL 3    &kp EQUAL     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp COMMA
                                                              &trans                &trans                     &trans          &trans        &trans        &kp N0
            >;
        };

        gesture {
            bindings = <
&none  &none  &none  &none      &none         &none    &none  &none         &kp LC(UP_ARROW)    &none          &none  &none
&none  &none  &none  &kp MINUS  &kp LG(PLUS)  &none    &none  &kp LC(LEFT)  &kp LC(DOWN_ARROW)  &kp LC(RIGHT)  &none  &none
&none  &none  &none  &none      &none         &none    &none  &none         &none               &none          &none  &none
                     &trans     &none         &none    &none  &none         &trans
            >;
        };
    };
};
