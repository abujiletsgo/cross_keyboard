/*
 * GPIO Diagnostic Shield — right side only, standalone (no split).
 *
 * 8 row candidates × 4 col candidates = 32 positions → unique chars '0'-'9','a'-'v'
 *
 * Row candidates (index 0-7):
 *   0: gpio0 6   (D0/TX  — never tried)
 *   1: gpio0 17  (D2     — never tried)
 *   2: gpio0 20  (D3     — never tried)
 *   3: gpio0 29  (D19    — CONFIRMED working row)
 *   4: gpio0 2   (D18    — tried, failed)
 *   5: gpio0 31  (D20    — tried, failed)
 *   6: gpio1 4   (D8     — never tried)
 *   7: gpio1 6   (D9     — never tried)
 *
 * Col candidates (index 0-3):
 *   0: gpio1 11  (D14 — CONFIRMED working col, innermost)
 *   1: gpio1 13  (D15 — CONFIRMED working col)
 *   2: gpio1 15  (D16 — CONFIRMED working col)
 *   3: gpio0 22  (D4  — tried as col, failed — trying again)
 *
 * Position = row_idx * 4 + col_idx
 * char: pos 0-9 → '0'-'9', pos 10-31 → 'a'-'v'
 *
 * With confirmed gpio0 29 (row 3) + gpio1 11 (col 0) → pos 12 → 'c'
 * With confirmed gpio0 29 (row 3) + gpio1 13 (col 1) → pos 13 → 'd'
 * With confirmed gpio0 29 (row 3) + gpio1 15 (col 2) → pos 14 → 'e'
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan_diag;
        zmk,matrix_transform = &diag_transform;
    };

    diag_transform: keymap_transform_diag {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <8>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3)
            RC(6,0) RC(6,1) RC(6,2) RC(6,3)
            RC(7,0) RC(7,1) RC(7,2) RC(7,3)
        >;
    };

    kscan_diag: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";

        row-gpios
            = <&gpio0 6  GPIO_ACTIVE_HIGH>
            , <&gpio0 17 GPIO_ACTIVE_HIGH>
            , <&gpio0 20 GPIO_ACTIVE_HIGH>
            , <&gpio0 29 GPIO_ACTIVE_HIGH>
            , <&gpio0 2  GPIO_ACTIVE_HIGH>
            , <&gpio0 31 GPIO_ACTIVE_HIGH>
            , <&gpio1 4  GPIO_ACTIVE_HIGH>
            , <&gpio1 6  GPIO_ACTIVE_HIGH>
            ;

        col-gpios
            = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
