#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <6>;

        /*
         * Transposed matrix: physical keyboard columns = firmware rows,
         *                    physical keyboard rows    = firmware cols
         *
         * Firmware rows (= physical columns, inner→outer):
         *   r0=gpio0 29  r1=gpio1 4  r2=gpio0 22  r3=gpio0 24  r4=gpio1 0  r5=gpio0 11
         * Physical col order L→R on keyboard: r0, r1, r5, r4, r3, r2
         *
         * Firmware cols (= physical rows, top→thumb):
         *   Left side (global cols 0-3):  c3=top  c2=mid  c1=bot  c0=thumb
         *   Right side (global cols 4-7): c7=top  c6=mid  c5=bot  c4=thumb
         */
        map = <
            RC(2,3) RC(3,3) RC(4,3) RC(5,3) RC(1,3) RC(0,3)    RC(0,7) RC(1,7) RC(5,7) RC(4,7) RC(3,7) RC(2,7)
            RC(2,2) RC(3,2) RC(4,2) RC(5,2) RC(1,2) RC(0,2)    RC(0,6) RC(1,6) RC(5,6) RC(4,6) RC(3,6) RC(2,6)
            RC(2,1) RC(3,1) RC(4,1) RC(5,1) RC(1,1) RC(0,1)    RC(0,5) RC(1,5) RC(5,5) RC(4,5) RC(3,5) RC(2,5)
                                             RC(5,0) RC(1,0) RC(0,0)    RC(0,4) RC(1,4) RC(5,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "row2col";
        row-gpios
            = <&gpio0 29 GPIO_ACTIVE_HIGH>
            , <&gpio1 4  GPIO_ACTIVE_HIGH>
            , <&gpio0 22 GPIO_ACTIVE_HIGH>
            , <&gpio0 24 GPIO_ACTIVE_HIGH>
            , <&gpio1 0  GPIO_ACTIVE_HIGH>
            , <&gpio0 11 GPIO_ACTIVE_HIGH>
            ;
    };
};
