#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/*
 * 32 positions (8 rows × 4 cols), each outputs a unique char.
 * pos = row_idx * 4 + col_idx
 * pos 0-9  → '0'-'9'
 * pos 10-31 → 'a'-'v'
 *
 * Row/col reference:
 *   rows: [gpio0 6, gpio0 17, gpio0 20, gpio0 29, gpio0 2, gpio0 31, gpio1 4, gpio1 6]
 *   cols: [gpio1 11, gpio1 13, gpio1 15, gpio0 22]
 *
 * Confirmed: gpio0 29 (row 3) + gpio1 11 (col 0) = pos 12 = 'c'
 *            gpio0 29 (row 3) + gpio1 13 (col 1) = pos 13 = 'd'
 *            gpio0 29 (row 3) + gpio1 15 (col 2) = pos 14 = 'e'
 */

/ {
    chosen {
        zmk,matrix_transform = &default_transform;
    };

    keymap {
        compatible = "zmk,keymap";
        diag {
            bindings = <
/* r0 */ &kp N0 &kp N1 &kp N2 &kp N3
/* r1 */ &kp N4 &kp N5 &kp N6 &kp N7
/* r2 */ &kp N8 &kp N9 &kp A  &kp B
/* r3 */ &kp C  &kp D  &kp E  &kp F
/* r4 */ &kp G  &kp H  &kp I  &kp J
/* r5 */ &kp K  &kp L  &kp M  &kp N
/* r6 */ &kp O  &kp P  &kp Q  &kp R
/* r7 */ &kp S  &kp T  &kp U  &kp V
            >;
        };
    };
};
