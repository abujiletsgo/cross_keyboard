#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/*
 * 20 positions (5 rows × 4 cols)
 * pos = row_idx * 4 + col_idx
 * pos 0-9 → '0'-'9', pos 10-19 → 'a'-'j'
 *
 * Rows: [gpio0 29, gpio1 4, gpio0 2, gpio0 31, gpio1 6]
 * Cols: [gpio1 11, gpio1 13, gpio1 15, gpio0 11]
 *
 * Expected from prev test:
 *   gpio0 29 + gpio1 11 = pos 0 → '0'  (thumb col 1)
 *   gpio0 29 + gpio1 13 = pos 1 → '1'  (bottom row col 1)
 *   gpio0 29 + gpio1 15 = pos 2 → '2'  (middle row col 1)
 *   gpio0 29 + gpio0 11 = pos 3 → '3'  (top row col 1 — if gpio0 11 is top row)
 *   gpio1 4  + gpio1 11 = pos 4 → '4'
 *   gpio1 4  + gpio1 13 = pos 5 → '5'
 *   gpio1 4  + gpio1 15 = pos 6 → '6'
 *   gpio1 4  + gpio0 11 = pos 7 → '7'
 *   gpio0 2  + gpio1 15 = pos 10 → 'a' (middle row col 3 — if gpio0 2 is col 3)
 *   gpio0 31 + gpio1 15 = pos 14 → 'e' (middle row col 4 — if gpio0 31 is col 4)
 */

/ {
    chosen {
        zmk,matrix_transform = &default_transform;
    };

    keymap {
        compatible = "zmk,keymap";
        diag {
            bindings = <
/* r0 */ &kp N0 &kp N1 &kp N2 &kp N3
/* r1 */ &kp N4 &kp N5 &kp N6 &kp N7
/* r2 */ &kp N8 &kp N9 &kp A  &kp B
/* r3 */ &kp C  &kp D  &kp E  &kp F
/* r4 */ &kp G  &kp H  &kp I  &kp J
            >;
        };
    };
};
