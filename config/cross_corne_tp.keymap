#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &five_column_transform;
    };
};

/ {
    //  Add tri-layer behavior here

    behaviors {
        tri_layer: sl_layer {
            compatible = "urob,zmk-behavior-simple-layer";
            label = "TRI_LAYER";
            layers = <1 2>;        // These are LWR and RSE layers
            target-layer = <3>;    // Layer 3 will activate when both are held
        };
    };

    combos {
        compatible = "zmk,combos";

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <21 20>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <2 3>;
        };

        gesture {
            bindings = <&mo 3>;
            key-positions = <38 39>;
        };

        backspace2 {
            bindings = <&kp BACKSPACE>;
            key-positions = <10 9>;
        };

        enter2 {
            bindings = <&kp ENTER>;
            key-positions = <22 21>;
        };

        esc2 {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <8 9>;
            layers = <3>;
        };

        ctrl_combo {
            bindings = <&kp LCTRL>;
            key-positions = <36 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Primary {
            display-name = "QWERTY";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E        &kp R         &kp T                           &kp Y              &kp U   &kp I        &kp O    &kp P     &kp BSPC
&kp CAPSLOCK    &kp A  &kp S  &kp D        &kp F         &kp G                           &kp H              &kp J   &kp K        &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C        &kp V         &kp B                           &kp N              &kp M   &kp COMMA    &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                              &kp LEFT_ALT  &mt LEFT_COMMAND C_AC_SEARCH  &lt 1 SPACE    &lt 1 SPACE  &kp RIGHT_COMMAND  &tog 2
            >;
        };

        Secondary {
            display-name = "Number";
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5       &kp NUMBER_6  &kp N7    &kp N8  &kp N9            &kp N0             &trans
&trans  &kp TILDE     &mkp MCLK     &mkp RCLK     &mkp LCLK     &mo 2        &mkp MB4      &mkp MB5  &none   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
&trans  &kp SLASH     &kp ASTERISK  &kp MINUS     &kp PLUS      &kp EQUAL    &none         &none     &trans  &trans            &none              &trans
                                    &trans        &trans        &trans       &trans        &trans    &trans
            >;
        };

        numpad+media {
            bindings = <
&kp C_POWER  &kp LG(LS(NUMBER_4))      &mt C_RW C_PREV       &mt C_PP C_PP         &mt C_FAST_FORWARD C_NEXT  &none     &kp ASTERISK  &kp N7        &kp N8        &kp N9        &kp PLUS    &none
&trans       &kp LS(LC(LG(NUMBER_4)))  &kp K_MUTE            &kp C_VOL_DN          &kp C_VOLUME_UP            &none     &kp SLASH     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS   &kp DOLLAR
&trans       &kp LS(LG(N5))            &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_AL_CONTROL_PANEL     &none     &kp EQUAL     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp COMMA
                                                             &trans                &trans                     &trans    &trans        &kp N0        &trans
            >;
        };

        Gesture {
            bindings = <
&kp F1  &kp F2  &kp F3              &kp F4            &kp F5         &kp F6    &kp F7  &kp F8          &kp F9          &kp F10     &kp F11        &kp F12
&none   &none   &none               &kp LC(UP_ARROW)  &mo 4          &none     &none   &none           &kp UP_ARROW    &kp LG(N0)  &kp LG(MINUS)  &kp LG(EQUAL)
&none   &none   &kp LC(LEFT_ARROW)  &kp LC(DOWN)      &kp LC(RIGHT)  &none     &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT   &none          &none
                                    &none             &none          &trans    &trans  &none           &none
            >;
        };

        Settings {
            bindings = <
&bt BT_CLR  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL    &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
&trans      &trans  &trans  &trans  &trans  &trans            &trans  &trans        &trans        &trans        &trans        &trans
&trans      &trans  &trans  &trans  &trans  &trans            &trans  &trans        &trans        &trans        &trans        &trans
                            &trans  &trans  &trans            &trans  &trans        &trans
            >;
        };
    };
};
